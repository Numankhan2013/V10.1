<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- The window already has the app's colours before the page paints, so
         launch never flashes white in dark mode. MainActivity follows the
         in-app theme from there (NK_NATIVE_FEEL_V1). -->
    <style name="Theme.QBankBiochemistry" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/qbank_background</item>
        <item name="android:statusBarColor">@color/qbank_background</item>
        <item name="android:navigationBarColor">@color/qbank_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">@color/qbank_foreground</item>
    </style>
</resources>
